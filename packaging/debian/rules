#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	# pure Perl — nothing to compile

override_dh_auto_install:
	$(MAKE) install install-man \
	    DESTDIR=$(CURDIR)/debian/changetrack-ng \
	    PREFIX=/usr
	# apt hooks
	install -d $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d
	install -m 644 packaging/hooks/apt-pre  $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d/80changetrack-ng-pre
	install -m 644 packaging/hooks/apt-post $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d/80changetrack-ng-post
	# cron job
	install -d $(CURDIR)/debian/changetrack-ng/etc/cron.hourly
	sed -e "s|@BINDIR@|/usr/bin|g" packaging/cron/changetrack-ng \
	    > $(CURDIR)/debian/changetrack-ng/etc/cron.hourly/changetrack-ng
	chmod 755 $(CURDIR)/debian/changetrack-ng/etc/cron.hourly/changetrack-ng
	# examples → /usr/share/doc (Makefile already installs to DOCDIR)
	# Ensure the examples directory is present even if Makefile missed it:
	install -d $(CURDIR)/debian/changetrack-ng/usr/share/doc/changetrack-ng/examples
	install -m 644 packaging/etc/examples/changetrack-ng.conf-full \
	    $(CURDIR)/debian/changetrack-ng/usr/share/doc/changetrack-ng/examples/
	install -m 644 packaging/etc/examples/changetrack-ng.conf-default \
	    $(CURDIR)/debian/changetrack-ng/usr/share/doc/changetrack-ng/examples/
	install -m 644 packaging/etc/examples/changetrack-ng.conf-minimal \
	    $(CURDIR)/debian/changetrack-ng/usr/share/doc/changetrack-ng/examples/
	install -m 644 packaging/etc/examples/changetrack-ng.conf-user \
	    $(CURDIR)/debian/changetrack-ng/usr/share/doc/changetrack-ng/examples/
	# Remove any erroneously installed /etc examples dir
	rm -rf $(CURDIR)/debian/changetrack-ng/etc/changetrack-ng/examples

override_dh_installsystemd:
	dh_installsystemd --no-enable changetrack-ng.service
	dh_installsystemd changetrack-ng.timer

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
