#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	# pure Perl — nothing to compile

override_dh_auto_test:
	@if echo " $(DEB_BUILD_OPTIONS) " | grep -q " nocheck "; then \
		echo "Skipping tests (DEB_BUILD_OPTIONS contains nocheck)"; \
	else \
		$(MAKE) test; \
	fi

override_dh_auto_install:
	$(MAKE) install install-man \
	    DESTDIR=$(CURDIR)/debian/changetrack-ng \
	    PREFIX=/usr \
	    DEFAULTSDIR=/etc/default
	# apt hooks
	install -d $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d
	sed -e "s|@BINDIR@|/usr/bin|g" -e "s|@DEFAULTSDIR@|/etc/default|g" packaging/hooks/apt-pre \
	    > $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d/80changetrack-ng-pre
	chmod 644 $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d/80changetrack-ng-pre
	sed -e "s|@BINDIR@|/usr/bin|g" -e "s|@DEFAULTSDIR@|/etc/default|g" packaging/hooks/apt-post \
	    > $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d/80changetrack-ng-post
	chmod 644 $(CURDIR)/debian/changetrack-ng/etc/apt/apt.conf.d/80changetrack-ng-post
	# cron job
	install -d $(CURDIR)/debian/changetrack-ng/etc/cron.hourly
	sed -e "s|@BINDIR@|/usr/bin|g" -e "s|@DEFAULTSDIR@|/etc/default|g" packaging/cron/changetrack-ng \
	    > $(CURDIR)/debian/changetrack-ng/etc/cron.hourly/changetrack-ng
	chmod 755 $(CURDIR)/debian/changetrack-ng/etc/cron.hourly/changetrack-ng

override_dh_installsystemd:
	dh_installsystemd --no-enable changetrack-ng.service
	dh_installsystemd changetrack-ng.timer

override_dh_installdocs:
	dh_installdocs README.md INSTALL.md ARCHITECTURE.md PRODUCT.md CONTRIBUTING.md

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
