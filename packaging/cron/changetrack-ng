#!/bin/sh
# /etc/cron.hourly/changetrack-ng
# Skip if the systemd timer is active (avoid duplicate runs).
if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet changetrack-ng.timer 2>/dev/null; then
        exit 0
    fi
fi
[ -f @DEFAULTSDIR@/changetrack-ng ] && . @DEFAULTSDIR@/changetrack-ng
exec @BINDIR@/changetrack-ng run --system --quiet ${CHANGETRACK_EXTRA_ARGS:-}
