// changetrack-ng post-install hook for apt
// Installed to /etc/apt/apt.conf.d/80changetrack-ng-post by `make install-hooks`
DPkg::Post-Invoke {"[ -f @DEFAULTSDIR@/changetrack-ng ] && . @DEFAULTSDIR@/changetrack-ng; @BINDIR@/changetrack-ng run --system --quiet ${CHANGETRACK_EXTRA_ARGS:-} -m 'post-install: apt' 2>/dev/null || true";};
