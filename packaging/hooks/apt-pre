// changetrack-ng pre-install hook for apt
// Installed to /etc/apt/apt.conf.d/80changetrack-ng-pre by `make install-hooks`
DPkg::Pre-Install-Pkgs {"[ -f @DEFAULTSDIR@/changetrack-ng ] && . @DEFAULTSDIR@/changetrack-ng; @BINDIR@/changetrack-ng run --system --quiet ${CHANGETRACK_EXTRA_ARGS:-} -m 'pre-install: apt' 2>/dev/null || true";};
