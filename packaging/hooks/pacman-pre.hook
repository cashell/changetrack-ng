[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = *

[Action]
Description = changetrack-ng: recording pre-transaction state
When = PreTransaction
Exec = /bin/sh -c '. @DEFAULTSDIR@/changetrack-ng 2>/dev/null || true; @BINDIR@/changetrack-ng run --quiet --lock-timeout 30 -m "pre-install: pacman" ${CHANGETRACK_EXTRA_ARGS:-}'
