[Unit]
Description=changetrack-ng system file change tracker
Documentation=man:changetrack-ng(8)
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/
EnvironmentFile=-@DEFAULTSDIR@/changetrack-ng
ExecStart=@BINDIR@/changetrack-ng run --system --quiet $CHANGETRACK_EXTRA_ARGS
StandardOutput=journal
StandardError=journal
