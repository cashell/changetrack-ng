# changetrack-ng — minimal starter configuration
#
# Tracks common config files with git and sends email notifications.
# Copy to /etc/changetrack-ng/changetrack-ng.conf and adjust.
# For all options, see the full reference config or run: man changetrack-ng.conf
#
# Drop-in config files:
# - Automatic drop-ins are loaded from sibling directories next to this file:
#     conf.d/*.conf      [global] sections only
#     track.d/*.conf     [track] sections only
#     notifier.d/*.conf  [notifier:*] sections only
# - Files are processed in sorted order.
# - Custom drop-in files or directories are supported with explicit include
#   directives in this file:
#     @include /path/to/extra.conf
#     @include-track /path/to/track.d/
#     @include-notifier /path/to/notifier.d/

[global]

# Track history with git (also: rcs fossil svn hg)
vcs = git
output_dir = /var/lib/changetrack-ng

[notifier:email:default]
enabled = true
from    = changetrack-ng@HOSTNAME
to      = root@localhost

[track]
/etc/passwd
/etc/group
/etc/hosts
/etc/hostname
/etc/fstab
DIRECTORY /etc/ssh
