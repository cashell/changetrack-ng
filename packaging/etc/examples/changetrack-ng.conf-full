# changetrack-ng — full reference configuration
#
# This file documents every supported option with detailed explanations.
# For quick-start use, see the other example configs:
#   -default — all options with defaults, concise comments
#   -minimal — bare essentials to get going
#   -user    — non-root, user-level install
#
# Copy to /etc/changetrack-ng/changetrack-ng.conf and adjust.
# Lines beginning with # are comments.  Blank lines are ignored.
#
# SECURITY: This file may contain notifier credentials (e.g., the OTLP
# notifier's headers key or webhook url with embedded tokens).
# Recommended file mode: 0640, owned root:root (or your service account).

###################################################################
# Global Configuration
###################################################################
#
[global]

##########################
# Core
##########################
#
# VCS backend used to store file history.
# Accepted: rcs | git | fossil | svn | hg
vcs = git

# Directory where tracked file history is stored.
# RCS stores flat ,v files here.  Git/Fossil/SVN/Hg use a mirror tree.
output_dir = /var/lib/changetrack-ng

# Remote(s) to push to after each commit (space-separated).
# Applies to whole-repo backends (git, fossil, svn, hg).
# Leave empty to skip push.
push_remote =

##########################
# Scheduling
##########################
#
# Run interval in seconds for systemd/cron install targets.
# Not read at runtime by changetrack-ng itself.
interval = 3600

##########################
# Locking
##########################
#
# Lock file path.  Only one instance runs at a time.
# Default for root:     /var/run/changetrack-ng.lock
# Default for non-root: $XDG_CACHE_HOME/changetrack-ng.lock
#                    or ~/.cache/changetrack-ng.lock
lock_path = /var/run/changetrack-ng.lock

# Seconds to wait to acquire the lock before giving up.
# 0 = skip silently if already locked (cron-friendly, default)
lock_timeout = 0

# Wall-clock timeout (seconds) for each external command (git/rcs/sendmail/etc).
# A hung or runaway command is killed after this many seconds so a single stuck
# command cannot hang a scheduled (cron/systemd) run.  Most commands finish in
# seconds; nothing should ever need more than a couple of minutes.
# 0 = no limit.
command_timeout = 120

##########################
# Sensitive Files
##########################
#
# Auto-detect sensitive files by permission mode.
# A file is treated as sensitive when it lacks both group-read and world-read
# permission (mode & 0044 == 0), e.g. mode 0600 or 0640.
# 1 = auto-detect (default) | 0 = disable auto-detection
sensitive_auto = 1

# How to handle sensitive file diffs in outbound notifications.
# suppress = redact diff with a placeholder (default; paths still logged)
# allow    = include full diff (only safe if the notification channel is private)
sensitive_notify = suppress

##########################
# Special File Warnings
##########################
#
# Emit warnings for non-regular files encountered during directory traversal
# (sockets, FIFOs, device nodes) and for regular files with multiple hard links.
# 1 = warn (default) | 0 = suppress
warn_special_files = 1

###################################################################
# File Tracking
###################################################################

##########################
# Ignore Patterns
##########################
#
# Additional glob patterns to skip during directory traversal
# (space-separated).  Applied on top of built-in defaults.
#
# Built-in defaults already exclude common noise:
#   editor temp files:  *.swp  *~  #*#  .*.sw?  *.bak
#   archives:           *.gz  *.bz2  *.bzip2  *.xz  *.zst  *.7z
#                       *.zip  *.tar  *.tgz  *.tbz2  *.txz
#   package manager:    *.dpkg-*  *.rpmnew  *.rpmsave  *.pacnew  *.pacorig
#   compiled bytecode:  *.pyc  *.pyo  *.elc
#   system runtime:     mtab  ld.so.cache  prelink.cache  adjtime
#                       udev/hwdb.bin  lvm/cache  lvm/archive
ignore =

###################################################################
# Notifiers
###################################################################
#
# Each [notifier:<type>:<name>] section configures one notification instance.
# type: email | webhook | otlp | file
# name: arbitrary label; defaults to "default" when omitted.
#
# Multiple instances of the same type are supported.  Add a second webhook
# instance named differently:
#   [notifier:webhook:dev] ...
#
# Each section MUST contain: enabled = true | false
# Disabled instances are discarded at parse time.
#
# Configs can be split across drop-in files in notifier.d/ sibling directory.

##########################
# Email
##########################
#
[notifier:email:default]
enabled = false

# Envelope sender address.
# HOSTNAME is substituted with the system FQDN at runtime.
from = changetrack-ng@HOSTNAME

# Default recipient address(es) for email notifications (space-separated).
# Used when a tracked entry does not specify per-entry recipients.
# Per-entry recipients (after the colon in [track] lines) override this.
# Example: to = root@localhost admin@example.com
to =

# Path to the sendmail binary.  Detected automatically if not set.
# Checked locations: /usr/sbin/sendmail, /usr/lib/sendmail, then $PATH.
# sendmail_path = /usr/sbin/sendmail

##########################
# Webhook
##########################
#
[notifier:webhook:default]
enabled = false

# URL(s) to POST a JSON change report to (space-separated).  Required.
url =

# Include full unified diff in the webhook payload.
# 0 = summary statistics only (default) | 1 = full diff text
full_diff = 0

# POST a heartbeat payload even when there are no changes.
# Useful for "alert on absence" monitoring at the receiver.
# 0 = disabled (default) | 1 = enabled
heartbeat = 0

# HTTP request timeout in seconds.
timeout = 10

# Disable TLS certificate verification for webhook delivery.
# Only for self-signed dev setups.  Never use in production.
# 0 = verify (default) | 1 = skip verification
insecure = 0

# Maximum byte length of the diff included in the webhook payload.
# 0 = unlimited (default).  When truncated, diff_truncated = true is set on the
# affected file entry.  Sensitive-suppressed diffs are never truncated.
# max_diff_bytes = 0

##########################
# OTLP / OpenTelemetry
##########################
#
[notifier:otlp:default]
enabled = false

# OTLP/HTTP log endpoint URL (must include /v1/logs).  Required unless
# overridden by $OTEL_EXPORTER_OTLP_LOGS_ENDPOINT or $OTEL_EXPORTER_OTLP_ENDPOINT.
endpoint =

# Include full unified diff text in each OTLP log record attribute (config_change.diff).
# 0 = summary only (default) | 1 = full diff
full_diff = 0

# HTTP body compression for OTLP exports.
# Accepted: gzip (default) | none
compression = gzip

# Additional HTTP request headers (space-separated key=value pairs).
# Escape spaces inside values with a backslash: Authorization=Bearer\ token
# Supports ${ENV_VAR} expansion -- keep secrets out of this file:
#   headers = Authorization=Bearer\ ${OTLP_TOKEN}
# Overridden by $OTEL_EXPORTER_OTLP_HEADERS.
headers =

# HTTP request timeout in seconds.
timeout = 10

# Disable TLS certificate verification for OTLP delivery.
# 0 = verify (default) | 1 = skip verification
insecure = 0

# Additional OTLP resource attributes (space-separated key=value pairs).
# Example: resource_attributes = deployment.environment=prod team=infra
resource_attributes =

# Send a heartbeat log record on every run, even when there are no changes.
# OTLP is a monitoring channel; heartbeats enable "alert on absence" detection.
# 0 = disabled | 1 = enabled (default)
heartbeat = 1

# When enabled, include the list of notified recipients as the
# config_change.notified attribute on each event.  Off by default to avoid
# leaking recipient lists into observability backends.
# 0 = omit (default) | 1 = include
# emit_recipients = 0

# Maximum byte length of the config_change.diff attribute.
# 0 = unlimited (default).  When truncated, config_change.diff_truncated = true
# is also set.  Sensitive-suppressed diffs are never truncated.
# max_diff_bytes = 0

# OTel severity level for file change/create/remove events.
# Accepted: DEBUG | INFO (default) | WARN | ERROR (case-insensitive).
# severity_change = INFO

# OTel severity level for heartbeat events.
# Accepted: DEBUG (default) | INFO | WARN | ERROR (case-insensitive).
# severity_heartbeat = DEBUG

# OTel severity level for run-warning events.
# Accepted: DEBUG | INFO | WARN (default) | ERROR (case-insensitive).
# severity_warning = WARN

##########################
# File (JSON Log)
##########################
#
[notifier:file:default]
enabled = false

# Path to the append-only JSON log file.  Required.
path = /var/log/changetrack-ng.jsonl

# Include full diff text in each JSON log record.
# 0 = metadata only (default) | 1 = full diff
full_diff = 0

# Append a heartbeat record on every run, even when there are no changes.
# 0 = disabled (default) | 1 = enabled
heartbeat = 0

# When enabled, include the list of notified recipients as the
# config_change.notified attribute on each event.  Off by default to avoid
# leaking recipient lists into log files.
# 0 = omit (default) | 1 = include
# emit_recipients = 0

# Maximum byte length of the config_change.diff attribute.
# 0 = unlimited (default).  When truncated, config_change.diff_truncated = true
# is also set.  Sensitive-suppressed diffs are never truncated.
# max_diff_bytes = 0

# OTel severity level for file change/create/remove events.
# Accepted: DEBUG | INFO (default) | WARN | ERROR (case-insensitive).
# severity_change = INFO

# OTel severity level for heartbeat events.
# Accepted: DEBUG (default) | INFO | WARN | ERROR (case-insensitive).
# severity_heartbeat = DEBUG

# OTel severity level for run-warning events.
# Accepted: DEBUG | INFO | WARN (default) | ERROR (case-insensitive).
# severity_warning = WARN

###################################################################
# Track List
###################################################################
#
[track]
#
# Each line specifies a file or directory to track.
#
# Syntax:
#   /absolute/path/to/file [: email@example.com ...] [option=value ...]
#   DIRECTORY /absolute/path [: email@example.com ...] [option=value ...]
#
# Optional per-entry recipients (after the colon) override the global email
# notifier's default to= for that entry.  Multiple addresses are space-separated.
#
# Per-entry options (key=value after the path/recipients):
#   sensitive=yes|no|auto   Override automatic sensitive-file detection
#
# Examples:
#   /etc/passwd : root@localhost
#   /etc/hosts
#   DIRECTORY /etc/nginx : admin@example.com
#   DIRECTORY /etc/ssl/private : security@example.com sensitive=yes
