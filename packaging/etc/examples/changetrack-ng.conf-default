# changetrack-ng — default configuration
#
# All options shown with default values.
# For detailed documentation, see the -full example config.
# Example configs installed to: /usr/share/doc/changetrack-ng/examples/

###################################################################
# Global Configuration
###################################################################
#
[global]

##########################
# Core
##########################
#
# VCS backend: rcs | git | fossil | svn | hg
vcs = git

# Directory where tracked file history is stored
output_dir = /var/lib/changetrack-ng

##########################
# Scheduling
##########################
#
# Run interval in seconds for systemd/cron install targets
# (informational; not read at runtime by changetrack-ng itself)
interval = 3600

##########################
# Locking
##########################
#
# Lock file path (only one instance runs at a time)
lock_path = /var/run/changetrack-ng.lock

# Seconds to wait for lock; 0 = skip silently if locked (cron-friendly)
lock_timeout = 0

##########################
# Sensitive Files
##########################
#
# Auto-detect sensitive files by mode (lacks group+world read = sensitive)
sensitive_auto = 1

# Handling of sensitive diffs in notifications: suppress | allow
sensitive_notify = suppress

# Warn on non-regular files (sockets, FIFOs, device nodes, hard links)
warn_special_files = 1

##########################
# VCS Push
##########################
#
# Remote(s) to push to after each commit (space-separated)
push_remote =

###################################################################
# File Tracking
###################################################################

##########################
# Ignore Patterns
##########################
#
# Additional globs to skip during traversal (space-separated)
# Built-in defaults already exclude: editor temps, archives, package
# manager artifacts, bytecode, and common system runtime files.
ignore =

###################################################################
# Notifiers
###################################################################
#
# Uncomment and adjust any [notifier:*] section to enable it.
# Multiple instances of the same type are supported — just use
# different names, e.g. [notifier:webhook:ops] and [notifier:webhook:dev].

# [notifier:email:default]
# enabled         = true
# from            = changetrack-ng@HOSTNAME
# to              =
# sendmail_path   = /usr/sbin/sendmail

# [notifier:webhook:default]
# enabled         = true
# url             =
# full_diff       = 0
# heartbeat       = 0
# insecure        = 0

# [notifier:otlp:default]
# enabled         = true
# endpoint        =
# compression     = gzip
# full_diff       = 0
# heartbeat       = 1
# timeout         = 10
# insecure        = 0
# headers         =
# resource_attributes =

# [notifier:file:default]
# enabled         = true
# path            = /var/log/changetrack-ng.jsonl
# full_diff       = 0
# heartbeat       = 0

[track]
##########################
# Track List
##########################
#
# Syntax:
#   /path/to/file [: recip@addr ...] [option=value ...]
#   DIRECTORY /path [: recip@addr ...] [option=value ...]
#
# Per-entry options: sensitive=yes|no|auto
#
# Examples:
# /etc/passwd
# /etc/hosts
# DIRECTORY /etc/ssh
# DIRECTORY /etc/nginx : admin@example.com
