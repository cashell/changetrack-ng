# changetrack-ng — user-level configuration
#
# For an unprivileged (non-root) install: make install-user
# Copy to ~/.config/changetrack-ng/changetrack-ng.conf and adjust.
# For all options, see the full reference config or run: man changetrack-ng.conf

###################################################################
# Global Configuration
###################################################################
#
[global]

##########################
# Core
##########################
vcs = git
output_dir = ~/.local/state/changetrack-ng

##########################
# Scheduling
##########################
# Used by: make install-user-systemd  or  make install-user-cron
interval = 3600

# Default is auto-selected as $XDG_CACHE_HOME/changetrack-ng.lock
# lock_path = ~/.cache/changetrack-ng.lock

# Wall-clock timeout (seconds) for each external command; 0 = no limit.
# The 120s default applies even when unset; uncomment to override.
# command_timeout = 120

###################################################################
# Notifiers
###################################################################
#
# For a desktop/laptop you may prefer no notifications at all; just
# browse history with: changetrack-ng log /path/to/file
#
# Uncomment and adjust the section(s) you want to use.

# [notifier:email:default]
# enabled = true
# from    = changetrack-ng@HOSTNAME
# to      = your@email.address

# [notifier:webhook:default]
# enabled = true
# url     = https://your.webhook.endpoint/path

# [notifier:otlp:default]
# enabled   = true
# endpoint  = https://your.otel.collector/v1/logs

# [notifier:file:default]
# enabled = true
# path    = ~/.local/state/changetrack-ng/changetrack-ng.jsonl

[track]
##########################
# Dotfiles and configs
##########################
~/.bashrc
~/.bash_profile
~/.zshrc
~/.profile
~/.gitconfig
~/.vimrc
~/.tmux.conf

# SSH config (auto-detected as sensitive -- no diff in notifications)
DIRECTORY ~/.ssh

# Application config directories (uncomment as needed)
# DIRECTORY ~/.config/mpv
# DIRECTORY ~/.config/alacritty
