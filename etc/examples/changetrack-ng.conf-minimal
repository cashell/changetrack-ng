# changetrack-ng minimal starter configuration
#
# This is the simplest possible configuration to get started.
# It tracks a handful of common config files using git, and
# sends email notifications to a single address.
#
# Copy to /etc/changetrack-ng/changetrack-ng.conf and adjust for your system.
# For all available options see /etc/changetrack-ng/changetrack-ng.conf.

[global]

# Track history with git (also supported: rcs fossil svn hg)
vcs        = git
output_dir = /var/lib/changetrack-ng

# Send email when files change.
# Remove 'email' or clear the line to disable notifications.
notify     = email

# Who emails come from and where they are sent by default.
# Per-entry recipients (set after the colon in [track]) override this.
email_from = changetrack-ng@HOSTNAME
email_to   = root@localhost

[track]
# Add the files and directories you want to track below.
# Full paths only.  Prefix DIRECTORY to track all files under a directory.
#
# Examples:
/etc/passwd
/etc/group
/etc/hosts
/etc/hostname
/etc/fstab
DIRECTORY /etc/ssh
