use strict;
use warnings;
use File::Spec;
use File::Basename qw(dirname);
use Cwd qw(abs_path);
use Pod::Checker qw(podchecker);
use File::Find qw(find);

# Resolve paths relative to the script directory
my $script_dir = dirname(abs_path($0));
my $repo_dir   = abs_path(File::Spec->catdir($script_dir, '..'));

my $bin_file    = File::Spec->catfile($repo_dir, 'bin', 'changetrack-ng');
my $man_file    = File::Spec->catfile($repo_dir, 'man', 'changetrack-ng.8');
my $agent_file = File::Spec->catfile($repo_dir, 'AGENTS.md');
if (!-f $agent_file) {
    my $legacy_file = File::Spec->catfile($repo_dir, 'CLAUDE.md');
    $agent_file = $legacy_file if -f $legacy_file;
}
my $readme_file = File::Spec->catfile($repo_dir, 'README.md');

# Validate existence of expected files
for my $file ($bin_file, $man_file, $agent_file, $readme_file) {
    if (!-f $file) {
        die "Error: Required file not found: $file\n";
    }
}

# Get canonical subcommands list from the dispatch table in bin/changetrack-ng
my $canonical = parse_dispatch_table($bin_file);

my $failed = 0;

# 1. Run checks across all documented subcommand sources
check_source('bin/changetrack-ng header comment', parse_bin_header($bin_file), $canonical);
check_source('bin/changetrack-ng usage help',     parse_bin_usage($bin_file),  $canonical);
check_source('bin/changetrack-ng inline POD',     parse_bin_pod($bin_file),    $canonical);
check_source('man/changetrack-ng.8 manual page',  parse_man_page($man_file),   $canonical);
check_source('AGENTS.md architectural reference', parse_agent_md($agent_file), $canonical);
check_source('README.md subcommands table',       parse_readme_md($readme_file), $canonical);

# 2. Check POD syntax across all modules, scripts, and manual pages
check_pod_syntax($repo_dir);

# 3. Check relative links across all documentation markdown files
check_markdown_links($repo_dir);

if ($failed) {
    warn "\ndoc-lint: ERROR -- documentation validation failed!\n";
    exit 1;
}

print "doc-lint: OK (subcommands sync, POD syntax, and markdown links verified)\n";
exit 0;

########################################################################
# Parsing Implementations
########################################################################

# parse_dispatch_table -- Extract canonical subcommands list from bin/changetrack-ng
sub parse_dispatch_table {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    my $in_dispatch = 0;
    while (<$fh>) {
        if (/my\s+%dispatch\s*=\s*\(/) {
            $in_dispatch = 1;
            next;
        }
        if ($in_dispatch) {
            if (/^\s*\);/) {
                last;
            }
            if (/^\s*['"]([^'"]+)['"]\s*=>/) {
                push @cmds, $1;
            }
        }
    }
    close $fh;
    @cmds = sort @cmds;
    return \@cmds;
}

# parse_bin_header -- Extract subcommands from comments at top of bin/changetrack-ng
sub parse_bin_header {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    while (<$fh>) {
        if (/subcommands\s*\(([^)]+)\)/) {
            my $raw = $1;
            $raw =~ s/[\.\s]//g;
            @cmds = split /,/, $raw;
            last;
        }
    }
    close $fh;
    @cmds = sort @cmds;
    return \@cmds;
}

# parse_bin_usage -- Extract subcommands from _usage heredoc in bin/changetrack-ng
sub parse_bin_usage {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    my $in_subcommands = 0;
    while (<$fh>) {
        if (/Subcommands:/) {
            $in_subcommands = 1;
            next;
        }
        if ($in_subcommands) {
            if (/Options:/ || /^\s*$/ || /^USAGE/) {
                last;
            }
            if (/^\s+([a-z\-]+)\s+/) {
                push @cmds, $1;
            }
        }
    }
    close $fh;
    @cmds = sort @cmds;
    return \@cmds;
}

# parse_bin_pod -- Extract subcommands from POD section in bin/changetrack-ng
sub parse_bin_pod {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    my $in_subcommands = 0;
    while (<$fh>) {
        if (/^=head1\s+SUBCOMMANDS/) {
            $in_subcommands = 1;
            next;
        }
        if ($in_subcommands) {
            if (/^=head1/ || /^=head2/ || /^=cut/) {
                last;
            }
            if (/^=item\s+C<([a-z\-]+)(?:\s+[^>]+)?>/) {
                push @cmds, $1;
            }
        }
    }
    close $fh;
    @cmds = sort @cmds;
    return \@cmds;
}

# parse_man_page -- Extract subcommands from man/changetrack-ng.8 POD
sub parse_man_page {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    my $in_subcommands = 0;
    while (<$fh>) {
        if (/^=head1\s+SUBCOMMANDS/) {
            $in_subcommands = 1;
            next;
        }
        if ($in_subcommands) {
            if (/^=head1/ || /^=head2/ || /^=cut/) {
                last;
            }
            if (/^=item\s+B<([a-z\-]+)>/) {
                push @cmds, $1;
            }
        }
    }
    close $fh;
    @cmds = sort @cmds;
    return \@cmds;
}

# parse_agent_md -- Extract subcommands from AGENTS.md (or legacy CLAUDE.md)
sub parse_agent_md {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    while (<$fh>) {
        if (/dispatches subcommands\s*\(([^)]+)\)/) {
            my $raw = $1;
            $raw =~ s/[`\s]//g;
            @cmds = split /,/, $raw;
            last;
        }
    }
    close $fh;
    @cmds = sort @cmds;
    return \@cmds;
}

# parse_claude_md -- Backwards compatibility alias for parse_agent_md
sub parse_claude_md {
    goto &parse_agent_md;
}

# parse_readme_md -- Extract subcommands from README.md Subcommands table
sub parse_readme_md {
    my ($file) = @_;
    open my $fh, '<', $file or die "Cannot open $file: $!\n";
    my @cmds;
    my $in_subcommands = 0;
    while (<$fh>) {
        if (/^##\s+Subcommands/) {
            $in_subcommands = 1;
            next;
        }
        if ($in_subcommands) {
            if (/^##/ || /^#\s/) {
                last;
            }
            if (/^\|\s*`([a-z\-]+)(?:\s+[^`]+)?`\s*\|/) {
                push @cmds, $1;
            }
        }
    }
    close $fh;
    my %seen;
    @cmds = grep { !$seen{$_}++ } @cmds;
    @cmds = sort @cmds;
    return \@cmds;
}

########################################################################
# Verification Helpers
########################################################################

# check_source -- Compare parsed subcommands against the canonical list
sub check_source {
    my ($source_name, $found_ref, $canonical_ref) = @_;

    my @found     = @$found_ref;
    my @canonical = @$canonical_ref;

    # Check length first
    my $differs = 0;
    if (scalar @found != scalar @canonical) {
        $differs = 1;
    }
    else {
        for my $i (0 .. $#canonical) {
            if ($found[$i] ne $canonical[$i]) {
                $differs = 1;
                last;
            }
        }
    }

    if ($differs) {
        warn "Mismatch in '$source_name':\n";
        warn "  Expected (canonical): " . join(', ', @canonical) . "\n";
        warn "  Found:                " . (scalar @found ? join(', ', @found) : '(none)') . "\n";
        $failed = 1;
    }
}

# check_pod_syntax -- Run Pod::Checker across bin, man pages, and all lib modules
sub check_pod_syntax {
    my ($base_dir) = @_;
    my @files = (
        File::Spec->catfile($base_dir, 'bin', 'changetrack-ng'),
        File::Spec->catfile($base_dir, 'man', 'changetrack-ng.8'),
        File::Spec->catfile($base_dir, 'man', 'changetrack-ng.conf.5'),
    );

    my $lib_dir = File::Spec->catdir($base_dir, 'lib');
    if (-d $lib_dir) {
        find({
            wanted => sub {
                push @files, $File::Find::name if /\.pm$/ && -f $File::Find::name;
            },
            no_chdir => 1,
        }, $lib_dir);
    }

    my $pod_errors = 0;
    open my $devnull, '>', File::Spec->devnull or die "Cannot open devnull: $!\n";

    for my $f (sort @files) {
        next unless -f $f;
        my $res = podchecker($f, $devnull);
        if ($res > 0) {
            warn "POD syntax error in '$f' ($res error(s))\n";
            $pod_errors += $res;
        }
    }
    close $devnull;

    if ($pod_errors) {
        $failed = 1;
        warn "doc-lint: ERROR -- $pod_errors POD syntax error(s) detected!\n";
    }
}

# check_markdown_links -- Verify that relative links in markdown docs point to existing files
sub check_markdown_links {
    my ($base_dir) = @_;
    my @md_files;

    for my $f (glob(File::Spec->catfile($base_dir, '*.md'))) {
        push @md_files, $f if -f $f;
    }

    my $docs_dir = File::Spec->catdir($base_dir, 'docs');
    if (-d $docs_dir) {
        find({
            wanted => sub {
                push @md_files, $File::Find::name if /\.md$/ && -f $File::Find::name;
            },
            no_chdir => 1,
        }, $docs_dir);
    }

    my $broken_links = 0;
    for my $md (sort @md_files) {
        open my $fh, '<', $md or do {
            warn "Cannot open '$md': $!\n";
            $broken_links++;
            next;
        };
        my $dir = dirname($md);
        my $lineno = 0;
        while (my $line = <$fh>) {
            $lineno++;
            while ($line =~ /\[([^\]]+)\]\(([^)]+)\)/g) {
                my ($text, $target) = ($1, $2);
                next if $target =~ /^(?:https?:|mailto:|#)/;
                $target =~ s/#.*$//;
                next if $target eq '';
                my $resolved = File::Spec->rel2abs($target, $dir);
                unless (-e $resolved) {
                    warn "Broken link in '$md' line $lineno: [$text]($target) -> target not found\n";
                    $broken_links++;
                }
            }
        }
        close $fh;
    }

    if ($broken_links) {
        $failed = 1;
        warn "doc-lint: ERROR -- $broken_links broken relative markdown link(s) detected!\n";
    }
}
